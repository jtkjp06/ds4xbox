<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <AssemblyName>DS4Xbox</AssemblyName>
    <RootNamespace>DS4Xbox</RootNamespace>
    <Description>DualSense to Xbox 360 XInput converter</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Authors>junji</Authors>
    <Company>junji</Company>
    <Product>DS4Xbox</Product>
    <Copyright>Copyright © 2026 junji</Copyright>
    <RepositoryUrl>https://github.com/jtkjp06/ds4xbox</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="UI\Resources\controller_logo.png" />
    <EmbeddedResource Include="UI\Resources\controller_logo_off.png" />
  </ItemGroup>

  <!-- 除外設定: サブフォルダにあるテストプロジェクトのコードをメインプロジェクトのビルドから除外 -->
  <ItemGroup>
    <Compile Remove="DS4Xbox.Tests\**" />
    <EmbeddedResource Remove="DS4Xbox.Tests\**" />
    <None Remove="DS4Xbox.Tests\**" />
  </ItemGroup>

  <!-- テストプロジェクトに対して internal クラスへのアクセスを許可する設定 -->
  <ItemGroup>
    <InternalsVisibleTo Include="DS4Xbox.Tests" />
  </ItemGroup>

</Project>
