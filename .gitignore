diagnostic_result.txt
ds4xbox.log

# IDE specific files
.vs/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# OS specific files
.DS_Store
Thumbs.db

# User-specific configuration (if any)
# appsettings.json はデフォルト値をリポジトリに含めるため、ここでは除外しません。
# ただし、ローカル専用の設定を持たせたい場合は個別に除外してください。
